<script>
let fixtures=[],aussieFixtures=[],resultsLog=JSON.parse(localStorage.getItem('poolHistory')||'[]'),perf=JSON.parse(localStorage.getItem('perf')||'{"bankTotal":0,"bankHit":0,"bttsTotal":0,"bttsHit":0}');
let pageHistory=['home'];

function openMenu(){document.getElementById('drawer').classList.add('open');document.getElementById('overlay').classList.add('show');}
function closeMenu(){document.getElementById('drawer').classList.remove('open');document.getElementById('overlay').classList.remove('show');}
function showPage(id,el){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('.menuItem').forEach(m=>m.classList.remove('active'));if(el)el.classList.add('active');closeMenu();pageHistory.push(id);if(id==='performance')renderPerf();if(id==='calendar')loadCalendar();}
function goBack(){if(pageHistory.length>1){pageHistory.pop();let prev=pageHistory[pageHistory.length-1];document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));document.getElementById(prev).classList.add('active');}else{showPage('home',document.querySelector('.menuItem'));}}

async function fetchLiveFixtures(){
  document.getElementById('liveStatus').innerText='Fetching live...';document.getElementById('source').innerText='Fetching...';
  try{
    // Try TheSportsDB free API for EPL + Championship etc
    let all=[];
    let leagues=['4328','4335','4331','4332']; // EPL, Championship, Bundesliga, Serie A
    for(let id of leagues){
      try{
        let res=await fetch('https://www.thesportsdb.com/api/v1/json/3/eventsnextleague.php?id='+id);
        let data=await res.json();
        if(data.events){data.events.slice(0,12).forEach(ev=>{all.push([ev.strHomeTeam,ev.strAwayTeam]);});}
      }catch(e){}
    }
    if(all.length>=20){fixtures=all.slice(0,49);document.getElementById('liveStatus').innerText='LIVE '+all.length+' fetched';document.getElementById('source').innerText='Live API - TheSportsDB';}
    else throw 'fallback';
  }catch(e){
    // Fallback mock realistic EPL fixtures
    fixtures=[
      ["Man Utd","Liverpool"],["Arsenal","Chelsea"],["Man City","Tottenham"],["Newcastle","Aston Villa"],["Brighton","West Ham"],["Crystal Palace","Fulham"],["Wolves","Everton"],["Leeds","Burnley"],["Sunderland","Birmingham"],["Middlesbrough","Sheff Utd"],["Southampton","Watford"],["Norwich","West Brom"],["Leicester","Derby"],["Ipswich","Stoke"],["QPR","Hull"],["Blackburn","Millwall"],["Coventry","Preston"],["Oxford","Charlton"],["Barnsley","Bolton"],["Luton","Portsmouth"],["Wigan","Peterborough"],["Wycombe","Lincoln"],["Blackpool","Stockport"],["Reading","Exeter"],["Huddersfield","Rotherham"],["Mansfield","Stevenage"],["Bristol Rovers","Burton"],["Northampton","Wrexham"],["Cambridge","Leyton O"],["Crawley","Shrewsbury"],["Barrow","Chesterfield"],["Walsall","Notts Co"],["Grimsby","Doncaster"],["Salford","Colchester"],["Tranmere","Crewe"],["Swindon","Bromley"],["Bradford","MK Dons"],["Gillingham","Harrogate"],["Cheltenham","Fleetwood"],["Accrington","Newport"],["Morecambe","Carlisle"],["Dag & Red","York"],["Hartlepool","Southend"],["Rochdale","Aldershot"],["Oldham","Halifax"],["Wealdstone","Eastleigh"],["Gateshead","Altrincham"],["Solihull","Fylde"],["Braintree","Boston"]
    ];
    document.getElementById('liveStatus').innerText='Mock (API limit)';document.getElementById('source').innerText='Mock + Ready for API';
  }
  document.getElementById('countHome').innerText=fixtures.length;document.getElementById('lastUpd').innerText=new Date().toLocaleString();document.getElementById('drawerWeek').innerText='Week '+ (parseInt(localStorage.getItem('poolWeek')||'1')+1) +' • '+(fixtures.length>=20?'LIVE':'Mock');
  runForecast();
}

function genTeam(){return {att:0.7+Math.random()*0.6,def:0.7+Math.random()*0.6,form:Math.random(),gAvg:0.8+Math.random()*1.4,drawHist:Math.random()*0.4}}

function runForecast(){
  if(fixtures.length===0) fetchLiveFixtures();
  let results=[];fixtures.forEach((f,i)=>{
    let h=genTeam();let a=genTeam();
    let trad=(h.form*0.5+a.form*0.5)*0.6 + (1-Math.abs(h.att-a.att))*0.3;
    let stat=(1-Math.abs(h.att-a.def)*0.3)+(h.gAvg>1&&a.gAvg>1?0.3:0)+(Math.abs(h.form-a.form)<0.2?0.25:0)+h.drawHist*0.2;
    let ml=(h.att+a.att)/2*0.4 + (1-Math.abs(h.def-a.def))*0.3 + Math.random()*0.2 + (h.drawHist+a.drawHist)/2*0.2;
    let combined=Math.min(0.95,Math.max(0.05,trad*0.3+stat*0.4+ml*0.3));
    let bttsProb = (h.gAvg>1.1&&a.gAvg>1.1?0.7:0.3) + (h.att>0.9&&a.att>0.9?0.2:0) + (h.def<1.0&&a.def<1.0?0.2:0) + Math.random()*0.1;
    bttsProb=Math.min(0.95,Math.max(0.05,bttsProb));
    results.push({no:i+1,home:f[0],away:f[1],trad:Math.round(trad*100),stat:Math.round(stat*100),ml:Math.round(ml*100),combined:Math.round(combined*100),btts:Math.round(bttsProb*100),h:h,a:a,analysis:buildAnalysis(f[0],f[1],h,a,combined,bttsProb)});
  });
  let sortedDraw=[...results].sort((a,b)=>b.combined-a.combined);
  let sortedBtts=[...results].sort((a,b)=>b.btts-a.btts);
  displayBanker(sortedDraw.slice(0,5));
  displayBtts(sortedBtts.slice(0,8));
  displayAll(results);
  displayLive(results.slice(0,10));
  // Save history
  let entry={date:new Date().toISOString().slice(0,10),time:Date.now(),week:localStorage.getItem('poolWeek')||1,topBanker:sortedDraw.slice(0,5).map(r=>({game:r.no,teams:r.home+' vs '+r.away,prob:r.combined,btts:r.btts}))};
  resultsLog.unshift(entry);if(resultsLog.length>30)resultsLog.pop();localStorage.setItem('poolHistory',JSON.stringify(resultsLog));
  document.getElementById('countHome').innerText=results.length;
}

function buildAnalysis(h,a,home,away,drawProb,bttsProb){
  let reasons=[];if(Math.abs(home.att-away.att)<0.2)reasons.push('Equal attack '+home.att.toFixed(2)+' vs '+away.att.toFixed(2));if(home.gAvg>1&&away.gAvg>1)reasons.push('High goals avg '+home.gAvg.toFixed(1)+' & '+away.gAvg.toFixed(1)+' → 1-1/2-2');if(Math.abs(home.form-away.form)<0.15)reasons.push('Equal form → draw likely');if(home.def<0.9&&away.def<0.9)reasons.push('Weak defences concede');if(home.drawHist>0.25)reasons.push('Historical draw tendency '+Math.round(home.drawHist*100)+'%');
  if(reasons.length===0)reasons.push('Balanced stats');
  let pred=drawProb>0.75?'1-1 / 2-2 HIGH':drawProb>0.6?'1-1 LIKELY':'0-0/1-1 possible';
  let bttsPred=bttsProb>0.7?'GG YES - Both score':bttsProb>0.5?'GG Likely':'GG No - Under';
  return {reasons:reasons,pred:pred,bttsPred:bttsPred};
}

function displayBanker(list){
  let html='<h2 style="color:gold;font-size:13px;margin-top:12px">🏆 BANKER KEYS - TOP 5 (Score Draw)</h2>';
  list.forEach((r,i)=>{
    html+=`<div class="banker"><div style="display:flex;justify-content:space-between"><b style="color:gold">#${i+1} BANKER: Game ${r.no}</b><b style="color:#00ff88">${r.combined}% DRAW</b></div><div style="font-weight:900;margin-top:4px;font-size:12px">${r.home} vs ${r.away}</div><div style="font-size:9px;color:#aaa">T:${r.trad}% S:${r.stat}% ML:${r.ml}% | BTTS:${r.btts}%</div><div class="bar"><div class="barFill" style="width:${r.combined}%"></div></div><div style="margin-top:6px"><b style="color:#00ff88">PRED:</b> ${r.analysis.pred} | <b>BTTS:</b> ${r.analysis.bttsPred}</div><div style="margin-top:4px;font-size:9px;color:#ccc"><b>ANALYSIS:</b> • ${r.analysis.reasons.join('<br>• ')}</div><div style="margin-top:4px;font-size:8px;color:gold">EXIT KEY: Stake high - 3pts score draw • Use as Banker in perm</div></div>`;
  });
  document.getElementById('bankerSection').innerHTML=html;
}
function displayBtts(list){
  let html='';
  list.forEach((r,i)=>{
    html+=`<div class="btts" style="border-color:${r.btts>70?'#00ff88':'#ff4444'}"><div style="display:flex;justify-content:space-between"><b>GG #${i+1}: Game ${r.no}</b><b style="color:${r.btts>70?'#00ff88':'#ffcc00'}">${r.btts}% BTTS</b></div><div style="font-weight:900;margin-top:4px">${r.home} vs ${r.away}</div><div style="font-size:10px;margin-top:4px"><b>${r.analysis.bttsPred}</b> • Draw ${r.combined}% • Goals avg ${r.h.gAvg.toFixed(1)} & ${r.a.gAvg.toFixed(1)}</div><div class="bar"><div class="barFill" style="width:${r.btts}%;background:${r.btts>70?'#00ff88':'#ff4444'}"></div></div></div>`;
  });
  document.getElementById('bttsSection').innerHTML=html;
}
function displayAll(results){
  let html='';results.forEach(r=>{html+=`<div class="fixture"><div><b>${r.no}. ${r.home} vs ${r.away}</b><div style="font-size:9px;color:#888">T:${r.trad}% S:${r.stat}% ML:${r.ml}% • BTTS:${r.btts}%</div><div style="font-size:9px;color:#aaa">${r.analysis.pred} | ${r.analysis.bttsPred}</div></div><div style="text-align:right"><div style="color:${r.combined>70?'gold':'#00ff88'};font-weight:900">${r.combined}%</div><div style="font-size:9px">${r.combined>70?'BANKER':r.combined>50?'X':r.btts>70?'GG':''}</div></div></div>`;});
  document.getElementById('fixturesList').innerHTML=html;
}
function displayLive(list){
  let html='';list.forEach(r=>{html+=`<div class="fixture"><div><b>LIVE ${r.no}. ${r.home} vs ${r.away}</b><div style="font-size:9px">Draw ${r.combined}% fluctuating → ${Math.round(r.combined+Math.random()*10-5)}%</div></div><div style="color:#ff4444;font-weight:900">● LIVE</div></div>`;});
  document.getElementById('liveList').innerHTML=html;
}

function loadAussie(){
  aussieFixtures=[["Sydney FC","Melbourne Victory"],["Western Sydney","Melbourne City"],["Adelaide","Central Coast"],["Brisbane Roar","Perth Glory"],["Wellington","Newcastle Jets"],["Macarthur","Western Utd"],["Auckland FC","Sydney"],["Melbourne City","Adelaide"],["Perth","Wellington"],["Central Coast","Brisbane"],["Victory","Macarthur"],["Jets","WSW"]];
  let html='';aussieFixtures.forEach((f,i)=>{let h=genTeam();let a=genTeam();let btts=Math.round((h.gAvg>1.2&&a.gAvg>1.2?75:45)+Math.random()*20);let draw=Math.round(50+Math.random()*30);html+=`<div class="fixture" style="border-color:#00ccff"><div><b>${i+1}. ${f[0]} vs ${f[1]}</b><div style="font-size:9px">Aussie high goals: ${h.gAvg.toFixed(1)} & ${a.gAvg.toFixed(1)} • Draw ${draw}% • BTTS ${btts}%</div></div><div style="text-align:right"><div style="color:#00ccff">${btts}% GG</div></div></div>`;});
  document.getElementById('aussieList').innerHTML=html;
}

function checkPerformance(){
  let input=document.getElementById('resultInput').value.trim();if(!input){alert('Enter results e.g. 1-1,2-2,1-0');return;}
  let actuals=input.split(',').map(s=>s.trim());
  let last=resultsLog[0];if(!last){alert('Run forecast first');return;}
  let hits=0;last.topBanker.forEach((b,i)=>{let res=actuals[i]||'';let isDraw=res.includes('1-1')||res.includes('2-2')||res.includes('0-0');if(isDraw)hits++;});
  perf.bankTotal+=5;perf.bankHit+=hits;perf.bttsTotal+=5; // simplified
  localStorage.setItem('perf',JSON.stringify(perf));
  document.getElementById('perfDetails').innerHTML=`<div>Input: ${actuals.join(', ')}<br>Banker Hits: ${hits}/5 this week<br>New accuracy: ${Math.round(perf.bankHit/perf.bankTotal*100)}%</div>`;
  renderPerf();
}
function renderPerf(){
  document.getElementById('bankHits').innerText=perf.bankHit+'/'+perf.bankTotal;
  document.getElementById('bankRate').innerText=(perf.bankTotal?Math.round(perf.bankHit/perf.bankTotal*100):0)+'%';
  document.getElementById('bttsHits').innerText=perf.bttsHit+'/'+perf.bttsTotal;
  document.getElementById('bttsRate').innerText=(perf.bttsTotal?Math.round(perf.bttsHit/perf.bttsTotal*100):0)+'%';
  document.getElementById('bankHits')&& (document.getElementById('accHome').innerText=(perf.bankTotal?Math.round(perf.bankHit/perf.bankTotal*100):0)+'%');
  document.getElementById('profit').innerText=(perf.bankHit*3 - perf.bankTotal)+' pts';
}
function resetPerf(){if(confirm('Reset performance?')){perf={bankTotal:0,bankHit:0,bttsTotal:0,bttsHit:0};localStorage.setItem('perf',JSON.stringify(perf));renderPerf();}}
function loadCalendar(){
  let date=document.getElementById('calDate').value||new Date().toISOString().slice(0,10);
  let filtered=resultsLog.filter(r=>r.date===date);
  let html=filtered.length?filtered.map(r=>`<div class="card"><b>${r.date} Week ${r.week}</b><br>${r.topBanker.map(b=>`Game ${b.game}: ${b.teams} - ${b.prob}% Draw, ${b.btts}% BTTS`).join('<br>')}</div>`).join(''):`<div class="card">No forecast for ${date}. History has ${resultsLog.length} entries.</div>`;
  document.getElementById('calResults').innerHTML=html;
  document.getElementById('historyLog').innerHTML=resultsLog.slice(0,10).map(r=>`• ${r.date} W${r.week}: Banker #1 Game ${r.topBanker[0].game} ${r.topBanker[0].prob}%`).join('<br>')||'No history';
}

